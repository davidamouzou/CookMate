# Copy to .env.local (or .env) and fill in.

# --- Supabase ---------------------------------------------------------------
# Project settings -> API. The anon key is public by design; row-level
# security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# --- AI generation (server-side only) ---------------------------------------
GEMINI_API_KEY=
IMAGE_GEN_MODEL_KEY=

# Optional. Override the models used for generation and for the web-grounded
# recipe search (/api/search/recipe). Both default to the model in
# src/lib/ai/gemini.ts; set GEMINI_SEARCH_MODEL if your key's default model
# does not offer Google Search grounding.
GEMINI_MODEL=
GEMINI_SEARCH_MODEL=

# --- Site -------------------------------------------------------------------
# Used for canonical URLs and the sitemap. Defaults to https://coooke.fr.
BASE_URL=
